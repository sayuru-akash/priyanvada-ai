# Environment Variables for Priyanvada AI
# Copy this file to .env.local and fill in your actual values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL Database URL (for data: characters, chats, messages)
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://priyanvada_user:mysecretpassword@localhost:5432/priyanvada_db
DATABASE_URL=postgresql://your_username:your_password@your_host:5432/your_database_name

# ===========================================
# SUPABASE CONFIGURATION (Authentication)
# ===========================================

# Supabase Project URL
# Get this from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (public)
# Get this from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (private - keep secret!)
# Get this from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ===========================================
# GOOGLE OAUTH CONFIGURATION
# ===========================================

# Google OAuth Client ID
# Get this from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
# Get this from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# OAuth Redirect URI (should match your Google OAuth app settings)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ===========================================
# GOOGLE GEMINI AI CONFIGURATION
# ===========================================

# Google Gemini API Key
# Get this from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-gemini-api-key

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# NextAuth Secret (generate a random string)
# You can generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-nextauth-secret-here

# Application URL (for production, change to your domain)
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# CREDIT SYSTEM CONFIGURATION
# ===========================================

# Remaining free credits for users
# Set to 0 to disable chat functionality and show upgrade prompts
# Users can still browse characters and use the app, but cannot chat
NEXT_PUBLIC_REMAINING_CREDITS=10

# ===========================================
# CLOUDINARY CONFIGURATION (Optional - for image uploads)
# ===========================================

# Cloudinary Cloud Name
# Get this from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Cloudinary API Key
CLOUDINARY_API_KEY=your-cloudinary-api-key

# Cloudinary API Secret
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================

# Node Environment
NODE_ENV=development

# Enable Next.js Turbopack for faster development
TURBOPACK=true